{
  "expo": {
    "name": "centroPermisos",
    "slug": "centroPermisos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.edu.utp.centropermisos",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app requiere acceso a la cámara para tomar fotos.",
        "NSLocationWhenInUseUsageDescription": "Se usa tu ubicación para mostrar contenido local.",
        "NSMicrophoneUsageDescription": "Se usa el micrófono para grabar notas de voz."
      }
    },
    "android": {
      "package": "pe.edu.utp.centropermisos",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      "expo-font"
    ]
  }
}
